	<subDataset name="for_map" uuid="7b997937-16be-45f5-9217-9b806425b010">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Foodmart Data Source"/>
		<queryString language="SQL">
			<![CDATA[SELECT
    COUNT(*) AS total_customers,
    COUNT(CASE WHEN marital_status = 'M' THEN 1 END) AS married_customer,
    COUNT(CASE WHEN gender = 'M' THEN 1 END) AS male_customer,
    COUNT(CASE WHEN gender = 'F' THEN 1 END) AS female_customer
FROM customer]]>
		</queryString>
		<field name="total_customers" class="java.lang.Long">
