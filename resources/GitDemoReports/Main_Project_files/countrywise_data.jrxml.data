	<queryString language="SQL">
		<![CDATA[SELECT 
    country,
    COUNT(*) AS total_customers,
    SUM(CASE WHEN gender = 'M' THEN 1 ELSE 0 END) AS total_male,
    SUM(CASE WHEN gender = 'F' THEN 1 ELSE 0 END) AS total_female
FROM customer
GROUP BY country;]]>
	</queryString>
